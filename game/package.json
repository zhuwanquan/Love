{
  "name": "one-year-room",
  "version": "1.0.0",
  "description": "一年·房间 — RC-7 对话体治愈叙事",
  "private": true,
  "scripts": {
    "cap:init": "npx cap init '一年·房间' 'com.rc7.oneyearroom' --web-dir .",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "cd android && gradlew assembleDebug",
    "cap:sync": "npx cap sync",
    "dev": "cd www && python -m http.server 8080"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
